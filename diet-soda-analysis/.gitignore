# =============================================================================
# diet-soda-analysis — track code + public HTML; keep data and junk out of git
# Track intentionally: src/**/*.py, scripts/**/*.py, index.html, requirements.txt,
#                      README.md, config.yaml, docs/, outputs/figures/ (charts for HTML)
# =============================================================================

# --- Data (never commit NHANES / mortality / parquet) ---
data/
**/data/raw/
**/data/interim/
**/data/processed/

# --- Unneeded / generated Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
.venv/
venv/
env/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# --- Jupyter noise (keep notebooks if you want; drop checkpoint junk) ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# --- Large / regenerable analysis tables (rebuild from pipeline) ---
# Keep figures so index.html chart paths work when the repo is opened.
outputs/tables/
outputs/myth_lab_report.html

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Logs / temp ---
*.log
tmp/
temp/
.DS_Store
